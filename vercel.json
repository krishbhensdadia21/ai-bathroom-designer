{
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{js/**,css/**,components/**,public/**,index.html}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}